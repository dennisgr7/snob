---
import Points from '@/components/Points.astro';
import Terminal from '@/components/Terminal.astro';
import { SCRIPTS } from '@/lib/content';

/** The command line's same answer twice: the view a person moves through, and the JSON a program reads. */
---

<h3 class="font-mono text-lg font-bold">
  {SCRIPTS.title} <span class="text-accent">{SCRIPTS.accent}</span>
</h3>
<p class="mt-3 max-w-[62ch] text-muted">{SCRIPTS.lead}</p>
<div class="mt-8 grid gap-6 lg:grid-cols-2">
  <div>
    <p class="mb-2 font-mono text-xs text-muted">{SCRIPTS.human.caption}</p>
    <Terminal label={SCRIPTS.human.label} lines={SCRIPTS.human.lines} />
  </div>
  <div>
    <p class="mb-2 font-mono text-xs text-muted">{SCRIPTS.machine.caption}</p>
    <Terminal label={SCRIPTS.machine.label} lines={SCRIPTS.machine.lines} />
  </div>
</div>
<div class="mt-12 grid gap-10 md:grid-cols-2">
  <div>
    <h4 class="font-mono text-sm font-bold">{SCRIPTS.flags.title}</h4>
    <Points points={SCRIPTS.flags.points} class="mt-4" />
  </div>
  <div>
    <h4 class="font-mono text-sm font-bold">{SCRIPTS.exitCodes.title}</h4>
    <dl class="mt-4 grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2 text-sm">
      {
        SCRIPTS.exitCodes.points.map((item) => (
          <>
            <dt class="font-mono text-accent">{item.term}</dt>
            <dd class="text-muted">{item.means}</dd>
          </>
        ))
      }
    </dl>
  </div>
</div>
